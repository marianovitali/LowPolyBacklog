@model BacklogItemViewModel

<div>
    <a href="@Url.Action("Details", "Library", new { id = Model.GameId })" style="text-decoration: none; color: #ccc;">
        &larr; CANCELAR Y VOLVER
    </a>
</div>

<form asp-action="Edit" method="post">
    <!-- campos ocultos -->
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="GameId" />
    <input type="hidden" asp-for="GameTitle" />
    <input type="hidden" asp-for="CoverImageUrl" />

    <div class="details-container">

        <!-- COLUMNA 1: Portada -->
        <div class="cover-section">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="Portada de @Model.GameTitle" style="max-width: 100%; border-radius: 5px;" />
            }
            else
            {
                <div class="no-cover" style="width: 100%; height: 300px; background-color: #333; display: flex; align-items: center; justify-content: center;">
                    Sin Portada
                </div>
            }
        </div>

        <!-- COLUMNA 2: Información del Progreso (Formulario) -->
        <div class="info-section">
            <h1>EDITAR PROGRESO: @Model.GameTitle</h1>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <ul style="list-style-type: none; padding: 0;">
                <li style="margin-bottom: 15px;">
                    <strong>ESTADO:</strong>
                    <select asp-for="Status" class="form-control" style="width: 100%; padding: 8px; margin-top: 5px; background-color: #222; color: white; border: 1px solid #555;">
                        <option value="Pending">Pendiente</option>
                        <option value="Playing">Jugando</option>
                        <option value="Paused">Pausado</option>
                        <option value="Completed">Completado</option>
                    </select>
                </li>
                <li style="margin-bottom: 15px;">
                    <strong>HORAS JUGADAS:</strong>
                    <input asp-for="HoursPlayed" class="form-control" type="number" min="0" style="width: 100%; padding: 8px; margin-top: 5px; background-color: #222; color: white; border: 1px solid #555;" />
                </li>
                <li style="margin-bottom: 15px;">
                    <strong>PUNTAJE (1-10):</strong>
                    <input asp-for="Rating" class="form-control" type="number" min="1" max="10" style="width: 100%; padding: 8px; margin-top: 5px; background-color: #222; color: white; border: 1px solid #555;" />
                </li>
            </ul>

            <div class="synopsis-box" style="margin-top: 20px;">
                <h3>NOTAS / RESEÑA</h3>
                <textarea asp-for="ReviewNotes" class="form-control" rows="5" style="width: 100%; padding: 8px; background-color: #222; color: white; border: 1px solid #555;"></textarea>
            </div>
        </div>

        <!-- COLUMNA 3: Paneles Laterales -->
        <div class="sidebar-section">

            <div class="admin-panel" style="background-color: #1a1a1a; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #333;">
                <h3>ACCIONES</h3>
                <button type="submit" style="background-color: #4CAF50; color: white; width: 100%; margin-bottom: 10px; padding: 10px; border: none; font-weight: bold; cursor: pointer; border-radius: 3px;">
                    GUARDAR CAMBIOS
                </button>
            </div>

            <!-- Placeholder Logo PSX -->
            <div class="psx-logo-placeholder">
                <img src="/images/psx-logo-mock.png" alt="PS Logo" style="max-width: 100%;" />
            </div>

        </div>
    </div>
</form>