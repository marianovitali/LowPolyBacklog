@model BacklogBoardViewModel

@{
    ViewData["Title"] = "Mi Backlog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-uppercase m-0" style="font-size: 2rem; text-shadow: 2px 2px 0 #000;">MI BACKLOG</h1>
    <span style="color: #aaa; font-size: 12px;">Arrastrá y soltá los juegos para actualizar tu progreso ⓘ</span>
</div>

<div class="row g-3 align-items-start">
    <!-- COLUMNA: PENDIENTES -->
    <div class="col-12 col-md-6 col-lg-3">
        <h4 class="status-magenta mb-3" style="font-size: 14px;">🕒 PENDIENTES (@Model.Pendientes.Count)</h4>
        <!-- ondragover y ondrop permiten que la columna entera reciba tarjetas -->
        <div class="kanban-column column-pending" id="Pending" ondragover="allowDrop(event)" ondrop="drop(event, 'Pending')">
            @foreach (var item in Model.Pendientes)
            {
                <partial name="_KanbanCard" model="item" />
            }
            <div class="kanban-drop-placeholder">+ Arrastrá juegos acá</div>
        </div>
    </div>

    <!-- COLUMNA: JUGANDO -->
    <div class="col-12 col-md-6 col-lg-3">
        <h4 style="color: var(--neon-green); font-size: 14px; margin-bottom: 1rem;">▶ JUGANDO (@Model.Jugando.Count)</h4>
        <div class="kanban-column column-playing" id="Playing" ondragover="allowDrop(event)" ondrop="drop(event, 'Playing')">
            @foreach (var item in Model.Jugando)
            {
                <partial name="_KanbanCard" model="item" />
            }
            <div class="kanban-drop-placeholder">+ Arrastrá juegos acá</div>
        </div>
    </div>

    <!-- COLUMNA: PAUSADOS -->
    <div class="col-12 col-md-6 col-lg-3">
        <h4 style="color: #ffd700; font-size: 14px; margin-bottom: 1rem;">⏸ PAUSADOS (@Model.Pausados.Count)</h4>
        <div class="kanban-column column-paused" id="Paused" ondragover="allowDrop(event)" ondrop="drop(event, 'Paused')">
            @foreach (var item in Model.Pausados)
            {
                <partial name="_KanbanCard" model="item" />
            }
            <div class="kanban-drop-placeholder">+ Arrastrá juegos acá</div>
        </div>
    </div>

    <!-- COLUMNA: COMPLETADOS -->
    <div class="col-12 col-md-6 col-lg-3">
        <h4 class="status-cyan mb-3" style="font-size: 14px;">🏆 COMPLETADOS (@Model.Completados.Count)</h4>
        <div class="kanban-column column-completed" id="Completed" ondragover="allowDrop(event)" ondrop="drop(event, 'Completed')">
            @foreach (var item in Model.Completados)
            {
                <partial name="_KanbanCard" model="item" />
            }
            <div class="kanban-drop-placeholder">+ Arrastrá juegos acá</div>
        </div>
    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.currentTarget.id);
        }

        function drop(ev, newStatus) {
            ev.preventDefault();

            var cardId = ev.dataTransfer.getData("text");
            var cardElement = document.getElementById(cardId);

            var oldColumn = cardElement.parentElement; 
            var targetColumn = ev.currentTarget;

            var placeholder = targetColumn.querySelector('.kanban-drop-placeholder');
            targetColumn.insertBefore(cardElement, placeholder);

            var dbId = cardId.replace('card-', '');

            updateBacklogStatus(dbId, newStatus, cardElement, oldColumn);
        }

        async function updateBacklogStatus(id, newStatus, cardElement, oldColumn) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch('/Backlog/UpdateKanbanStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token 
                    },
                    body: JSON.stringify({
                        id: parseInt(id),
                        status: newStatus
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    
                    mostrarErrorRetro(errorData.message);

                    var oldPlaceholder = oldColumn.querySelector('.kanban-drop-placeholder');
                    if (oldPlaceholder) {
                        oldColumn.insertBefore(cardElement, oldPlaceholder);
                    } else {
                        oldColumn.appendChild(cardElement);
                    }
                    return; 
                }

                console.log('Estado actualizado correctamente en la API');

            } catch (error) {
                console.error('Error actualizando estado:', error);
                mostrarErrorRetro('Error crítico de red. El sistema no pudo conectar.');
                
                oldColumn.appendChild(cardElement);
            }
        }

        function mostrarErrorRetro(mensaje) {
            const alertaHtml = `
                <div id="alerta-kanban-js" class="mx-auto mb-4 p-3" style="max-width: 650px; background-color: #000; border: 2px solid var(--neon-magenta); box-shadow: 0 0 10px rgba(255, 0, 255, 0.4); border-radius: 4px;">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size: 1.2rem;">⚠️</span>
                        <strong style="color: var(--neon-magenta); letter-spacing: 1px;">ERROR DE SISTEMA:</strong>
                    </div>
                    <p class="m-0 mt-2 text-white" style="font-size: 0.95rem;">
                        ${mensaje}
                    </p>
                </div>
            `;

            const mainContainer = document.querySelector('main');
            
            const alertaVieja = document.getElementById('alerta-kanban-js');
            if (alertaVieja) {
                alertaVieja.remove();
            }

            mainContainer.insertAdjacentHTML('afterbegin', alertaHtml);

            setTimeout(() => {
                const alertaParaBorrar = document.getElementById('alerta-kanban-js');
                if (alertaParaBorrar) alertaParaBorrar.remove();
            }, 4000);
        }
    </script>
}