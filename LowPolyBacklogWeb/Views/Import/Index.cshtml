@model List<LowPolyBacklogWeb.Models.IgdbSearchResultViewModel>

@{
    ViewData["Title"] = "Importar desde IGDB";
}

<div style="text-align: center; margin-bottom: 2rem;">
    <h1>Base de Datos Global (IGDB)</h1>
    <p>Buscá joyas ocultas de PSX en la red y agregalas a tu catálogo local.</p>
</div>

<!-- FORM BUSQUEDA -->
<div style="background-color: #1e1e1e; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #444; text-align: center;">
    <form method="get" asp-action="Index" style="display: flex; gap: 15px; justify-content: center; align-items: center; flex-wrap: wrap;">
        
        <!-- VIEWDATA -->
        <input type="text" name="searchQuery" value="@ViewData["CurrentSearch"]" placeholder="Ej: Crash Bandicoot, Dino Crisis..."
               style="padding: 10px; border-radius: 4px; border: 1px solid #555; background-color: #222; color: white; width: 300px; font-size: 1rem;" required />
               
        <button type="submit" style="padding: 10px 25px; background-color: #0078d4; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1rem;">
            Buscar en IGDB
        </button>
        
    </form>
</div>

<!-- RESULTADOS -->
@if (Model != null && Model.Any())
{
    <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
        
        @foreach (var game in Model)
        {
            <div style="background-color: #1e1e1e; color: white; padding: 15px; border-radius: 8px; width: 220px; text-align: center; border: 2px solid #555;">
                
                <!-- IGDB. -->
                @if (!string.IsNullOrEmpty(game.CoverImageUrl))
                {
                    <img src="@game.CoverImageUrl" alt="Portada de @game.Title" style="width: 100%; height: auto; border-radius: 4px; margin-bottom: 10px;" />
                }
                else
                {
                    <div style="width: 100%; height: 280px; background-color: #333; border-radius: 4px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; color: #777;">
                        Sin Imagen
                    </div>
                }
                
                <h3 style="font-size: 1.1rem; margin: 0 0 10px 0;">@game.Title</h3>
                <p style="margin: 0; color: #aaa; font-size: 0.9rem;">Año: @(game.ReleaseYear > 0 ? game.ReleaseYear : "N/A")</p>
                
                
                <button style="margin-top: 15px; padding: 8px 15px; background-color: #00ffcc; color: black; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%;">
                    ⬇ Importar al Catálogo
                </button>
            </div>
        }

    </div>
}
else if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
{
    <div style="text-align: center; padding: 3rem; color: #aaa;">
        <h3>No encontramos resultados en IGDB para "@ViewData["CurrentSearch"]".</h3>
        <p>Intentá buscar con otro nombre.</p>
    </div>
}