<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LowPoly Backlog</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LowPolyBacklogWeb.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <header>
        <nav style="background-color: #1e1e1e; border-bottom: 2px solid #333; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <a asp-controller="Library" asp-action="Index" style="color: #00ffcc; font-size: 1.5rem; font-weight: bold; text-decoration: none; letter-spacing: 1px;">
                    🎮 LowPoly Backlog
                </a>
            </div>
            <div style="display: flex; gap: 20px; align-items: center;">
                
                <a asp-controller="Library" asp-action="Index" style="color: white; text-decoration: none; font-weight: bold;">
                    Mi Biblioteca
                </a>
                
                <a asp-controller="Import" asp-action="Index" style="background-color: #0078d4; color: white; text-decoration: none; font-weight: bold; padding: 8px 15px; border-radius: 4px;">
                    ➕ Buscar Juegos
                </a>
                
            </div>
        </nav>
    </header>
    <div class="container" style="margin-top: 40px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer style="border-top: 1px solid #333; text-align: center; padding: 20px; margin-top: 50px; color: #aaa;">
        <div class="container">
            &copy; 2026 - LowPoly Backlog - Proyecto PSX
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
