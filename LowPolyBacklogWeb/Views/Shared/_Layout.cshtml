<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Low Poly</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid d-flex justify-content-center p-0">
        <!-- Wrapper del navegador IE5 -->
        <div class="browser-window">
            <div class="browser-topbar">
                <span>Low Poly - Polygon Internet Explorer Browser v5</span>
                <span>□ ×</span>
            </div>

            <div class="browser-menu">
                Archivo &nbsp; Editar &nbsp; Ver &nbsp; Favoritos &nbsp; Ayuda
            </div>

            <header class="hero-banner">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-lowpoly2.png" alt="Low Poly Logo" class="img-fluid" style="max-width: 420px;" />
                </a>
            </header>

            <nav class="retro-nav d-flex justify-content-center gap-3 flex-wrap mb-5">
                <a asp-controller="Home" asp-action="Index" class="btn-retro">INICIO</a>
                <a asp-controller="Library" asp-action="Index" class="btn-retro">CATALOGO</a>
                <a asp-controller="Backlog" asp-action="Index" class="btn-retro">MI BACKLOG</a>
                <a class="btn-retro" asp-controller="Home" asp-action="About" >SOBRE LOWPOLY</a>
            </nav>

            <main role="main" class="p-4 p-md-5">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="mx-auto mb-4 p-3" style="max-width: 650px; background-color: #000; border: 2px solid var(--neon-magenta); box-shadow: 0 0 10px rgba(255, 0, 255, 0.4); border-radius: 4px;">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size: 1.2rem;">⚠️</span>
                            <strong style="color: var(--neon-magenta); letter-spacing: 1px;">ERROR DE SISTEMA:</strong>
                        </div>
                        <p class="m-0 mt-2 text-white" style="font-size: 0.95rem;">
                            @TempData["ErrorMessage"]
                        </p>
                    </div>
                }

                @RenderBody()
            </main>

            <div class="text-center pb-2" style="color: var(--neon-cyan); font-size: 11px; background: var(--bg-deep-blue);">
                Low Poly © 2026 - Todos los derechos reservados
            </div>

            <div class="classic-status-bar">
                <div class="status-section status-left">
                    <img src="~/images/ie-lupa-icon.png" alt="Listo" class="status-icon" />
                    <span>Listo</span>
                </div>

                <div class="status-section status-empty"></div>

                <div class="status-section status-right">
                    <img src="~/images/ie-globe-icon.png" alt="Internet" class="status-icon" />
                    <span>Internet</span>
                </div>

                <!-- Grip de la esquina -->
                <div class="resize-grip"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>