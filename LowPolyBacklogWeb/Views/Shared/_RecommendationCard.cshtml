@model GameRecommendationViewModel

<div class="retro-card">
    <div class="d-flex gap-3 h-100">
        <div class="flex-shrink-0">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid border border-dark" style="width: 100px; height: 100px; object-fit: cover;" />
            }
        </div>

        <div class="d-flex flex-column justify-content-between w-100">
            <div>
                <h4 style="font-size: 14px; margin-bottom: 8px; line-height: 1.4; text-shadow: 2px 2px 0 #000;">@Model.Title</h4>
                <!-- Texto diferenciador -->
                <p class="status-magenta" style="font-size: 10px; margin-bottom: 0; text-shadow: 1px 1px 0 #000;">⭐ Sugerencia del mes</p>
            </div>
            <div class="mt-3">
                <a asp-controller="Library" asp-action="Details" asp-route-id="@Model.Id" class="btn-retro btn-retro-small text-center">
                    VER DETALLES
                </a>
            </div>
        </div>
    </div>
</div>