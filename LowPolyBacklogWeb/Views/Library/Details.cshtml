@model GameDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<!-- Botón Volver -->
<div class="mb-4">
    <a asp-action="Index" asp-controller="Library" class="text-white text-decoration-none" style="font-size: 12px; text-shadow: 1px 1px 0 #000;">
        &larr; VOLVER A MI LIBRERÍA
    </a>
</div>

<div class="row g-4">
    <!-- ========================================== -->
    <!-- COLUMNA 1: Portada (Izquierda)             -->
    <!-- ========================================== -->
    <div class="col-12 col-md-3">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <!-- Simulamos la caja de PSX con un borde grueso y fondo negro -->
            <div class="p-2 bg-dark border border-secondary" style="box-shadow: 5px 5px 0 rgba(0,0,0,0.5);">
                <img src="@Model.CoverImageUrl" alt="Portada de @Model.Title" class="img-fluid w-100" style="object-fit: cover;" />
            </div>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center bg-secondary text-white border border-dark" style="height: 350px; box-shadow: 5px 5px 0 rgba(0,0,0,0.5);">
                <span>Sin Portada</span>
            </div>
        }
    </div>

    <!-- ========================================== -->
    <!-- COLUMNA 2: Info Principal (Centro)         -->
    <!-- ========================================== -->
    <div class="col-12 col-md-5">
        <h1 class="text-uppercase mb-4" style="font-size: 1.8rem; text-shadow: 2px 2px 0 #000;">@Model.Title</h1>

        <ul class="list-unstyled mb-4" style="font-size: 12px; line-height: 2;">
            <li><strong class="status-cyan">AÑO DE LANZAMIENTO:</strong> @Model.ReleaseYear</li>
            <li><strong class="status-cyan">DESARROLLADOR:</strong> @(Model.Developer ?? "Desconocido")</li>
            <li><strong class="status-cyan">GÉNEROS:</strong> @(Model.Genres != null && Model.Genres.Any() ? string.Join(", ", Model.Genres.Select(g => g.Name)) : "Sin especificar")</li>
            <li><strong class="status-cyan">DISCOS:</strong> @Model.DiscCount Disco(s)</li>
        </ul>

        <div class="retro-box border-magenta mt-4">
            <h3 class="status-magenta mb-3" style="font-size: 14px;">SINOPSIS</h3>
            <p style="font-size: 11px; line-height: 1.6; color: #ddd; margin: 0;">
                @(Model.Synopsis ?? "No hay sinopsis disponible en la base de datos para este título.")
            </p>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- COLUMNA 3: Paneles de Control (Derecha)    -->
    <!-- ========================================== -->
    <div class="col-12 col-md-4 d-flex flex-column gap-4">

        <!-- Panel Admin -->
        <div class="retro-card border-magenta" style="height: max-content;">
            <h3 class="text-center mb-3" style="font-size: 14px;">MODO ADMIN</h3>
            <a asp-controller="Library" asp-action="Edit" asp-route-id="@Model.Id" class="btn-retro btn-retro-yellow text-center mb-3 w-100">
                ✏️ EDITAR JUEGO
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="w-100" onsubmit="return confirm('¿Estás seguro que querés borrar este juego de la base de datos? Esta acción no se puede deshacer.');">
                <button type="submit" class="btn-retro btn-retro-red w-100">
                    🗑️ ELIMINAR JUEGO
                </button>
            </form>
        </div>

        <!-- Panel Backlog -->
        <div class="retro-card border-cyan" style="height: max-content;">
            <h3 class="text-center status-cyan mb-3" style="font-size: 14px;">TU ESTADO EN BACKLOG</h3>

            @if (Model.BacklogInfo != null)
            {
                <div style="font-size: 11px; line-height: 1.8;">
                    <div class="d-flex justify-content-between">
                        <span>ESTADO:</span>
                        <span style="color: var(--neon-green);">@Model.BacklogInfo.Status</span>
                    </div>

                    <div class="mt-2 mb-2">
                        <span>PROGRESO: 65%</span>
                        <div class="retro-progress-bg">
                            <!-- El width de este div interno controlaría el porcentaje real cuando lo dinamicés -->
                            <div class="retro-progress-fill" style="width: 65%;"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>HORAS JUGADAS:</span>
                        <span>@Model.BacklogInfo.HoursPlayed h</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>RATING:</span>
                        <span style="color: #ffd700; font-size: 10px;">
                            @(Model.BacklogInfo.Rating != null ? new string('★', Model.BacklogInfo.Rating.Value) + new string('☆', 10 - Model.BacklogInfo.Rating.Value) : "Sin calificar")
                        </span>
                    </div>

                    <div class="p-2 bg-dark border border-secondary mb-3">
                        <strong class="status-cyan d-block mb-1">NOTAS:</strong>
                        <p class="m-0" style="color: #ccc;">@(Model.BacklogInfo.ReviewNotes ?? "Sin notas adicionales.")</p>
                    </div>
                </div>

                <a asp-controller="Backlog" asp-action="Edit" asp-route-id="@Model.BacklogInfo.Id" class="btn-retro btn-retro-small text-center w-100 bg-light">
                    EDITAR MI ESTADO
                </a>
            }
            else
            {
                <p class="text-center text-muted my-4" style="font-size: 11px;">No tenés este juego en tu backlog.</p>
                <form asp-controller="Backlog" asp-action="AddToBacklog" method="post">
                    <input type="hidden" name="gameId" value="@Model.Id" />
                    <button type="submit" class="btn-retro text-center w-100" style="background: var(--neon-magenta); color: white; border-color: white;">
                        + AGREGAR A MI BACKLOG
                    </button>
                </form>
            }
        </div>

        <!-- Placeholder del Logo PSX -->
@*         <div class="text-center mt-auto p-3">
            <img src="~/images/psx-logo-mock.png" alt="PSX Logo" class="img-fluid" style="opacity: 1; max-width: 50px;" />
        </div> *@
    </div>
</div>

<!-- ========================================== -->
<!-- SECCIÓN INFERIOR: Comentarios (Mock)       -->
<!-- ========================================== -->
<div class="mt-5">
    <h3 class="mb-4 pb-2 border-bottom d-inline-block" style="border-color: var(--ie-grey) !important; font-size: 1.2rem;">
        COMENTARIOS DEL BACKLOG
    </h3>

    <div class="d-flex flex-column">
        <!-- Mock Comentario 1 -->
        <div class="retro-comment-row d-flex gap-3">
            <div class="flex-shrink-0">
                <div style="width: 50px; height: 50px; background-color: #333; border: 2px solid var(--ie-grey); display: flex; justify-content: center; align-items: center;">
                    <span style="font-size: 20px;">👤</span>
                </div>
            </div>
            <div class="w-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="status-cyan" style="font-size: 12px;">SolidFan_84</strong>
                    <span style="color: var(--ie-grey); font-size: 10px;">15/05/2024</span>
                </div>
                <p style="font-size: 11px; line-height: 1.5; color: #ddd; margin-bottom: 8px;">
                    Obra maestra del sigilo. La historia, los personajes y la tensión que genera son increíbles. ¡Imprescindible en cualquier backlog!
                </p>
                <span style="color: #ffd700; font-size: 12px;">RATING: ★★★★★</span>
            </div>
        </div>

        <!-- Mock Comentario 2 -->
        <div class="retro-comment-row d-flex gap-3 border-cyan">
            <div class="flex-shrink-0">
                <div style="width: 50px; height: 50px; background-color: #333; border: 2px solid var(--ie-grey); display: flex; justify-content: center; align-items: center;">
                    <span style="font-size: 20px;">👱‍♀️</span>
                </div>
            </div>
            <div class="w-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="status-cyan" style="font-size: 12px;">PsychoMantis</strong>
                    <span style="color: var(--ie-grey); font-size: 10px;">03/04/2024</span>
                </div>
                <p style="font-size: 11px; line-height: 1.5; color: #ddd; margin-bottom: 8px;">
                    El jefe Psycho Mantis me voló la cabeza de chico 😭 Juegazo eterno.
                </p>
                <span style="color: #ffd700; font-size: 12px;">RATING: ★★★★☆</span>
            </div>
        </div>
    </div>
</div>